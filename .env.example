# HTTP
PORT=8787
HOST=127.0.0.1
CONFIG_PATH=./config/clients.json
DATABASE_PATH=./data/gmv-max.sqlite
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ADMIN_API_KEY=replace-with-at-least-43-random-base64url-characters

# Safety: keep false until sandbox and a low-budget production test pass.
# Set true while only LINE webhook/pairing is available. This overrides both
# flags below to false and does not require TIKTOK_ACCESS_TOKEN.
CONTROL_PLANE_ONLY=false
EXECUTION_ENABLED=false
MONITOR_ENABLED=false
STARTUP_VALIDATION_ENABLED=true

# Read-only Chrome telemetry. Enabling this adds only signed snapshot ingest;
# it never grants TikTok write access. Each extension installation enrolls a
# P-256 public key with a one-time code issued by the admin endpoint.
CHROME_TELEMETRY_ENABLED=false
# Optional LINE approval dry-run. Requires both signed telemetry and
# CONTROL_PLANE_ONLY=true; it never enables TikTok reads or writes.
CHROME_TELEMETRY_ALERTS_ENABLED=false
CHROME_TELEMETRY_MAX_CLOCK_SKEW_SECONDS=300

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# TikTok API for Business (Marketing API v1.3)
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
# Read-only Ppan Creator API bridge. Keep all TikTok writers disabled.
CREATOR_READ_ENABLED=false
CREATOR_READ_URL=https://gmv-max-report-production-3251.up.railway.app/internal/creator/punpan_020/snapshot
CREATOR_READ_BRIDGE_KEY=

# Optional Railway-to-Render policy bridge; use a separate random key on both peers.
# The cap flag only changes a local policy. It does not send TikTok writes or start Auto.
CREATOR_WEB_POLICY_BRIDGE_KEY=
CREATOR_WEB_POLICY_LEASE_ENABLED=false
CREATOR_WEB_SRIHIW_BUDGET_LEASE_ENABLED=false
CREATOR_WEB_POLICY_CAP_WRITE_ENABLED=false
# Set true after the website cap controls have been verified. Keeps LINE cap reads and alerts.
CREATOR_LINE_CAP_WRITE_DISABLED=false
# Gate all operational LINE commands; retain pairing, status reads and notifications.
CREATOR_LINE_WEBSITE_ONLY=false
